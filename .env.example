# 🤖 SMC Trading Bot — Configuration Template

# ─── Telegram ──────────────────────────────────────────────
# Get token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Get your ID from @userinfobot
TELEGRAM_ADMIN_IDS=12345678,87654321

# ─── MetaTrader 5 (Live Mode) ──────────────────────────────
# These are used when /mode live is active
MT5_LIVE_LOGIN=12345678
MT5_LIVE_PASSWORD=your_password
MT5_LIVE_SERVER=Broker-LiveServer
# Path to terminal64.exe (Optional, usually for Wine/Linux)
MT5_LIVE_PATH=C:\\Program Files\\MetaTrader 5 Terminal\\terminal64.exe

# ─── MetaTrader 5 (Demo Mode) ──────────────────────────────
# These are used when /mode demo is active
MT5_DEMO_LOGIN=87654321
MT5_DEMO_PASSWORD=your_demo_password
MT5_DEMO_SERVER=Broker-DemoServer
MT5_DEMO_PATH=C:\\Program Files\\MetaTrader 5 Terminal\\terminal64.exe

# ─── Trading Defaults ──────────────────────────────────────
# mode: demo | live. Keep AUTO_TRADE=false until you have reviewed a demo scan.
TRADING_MODE=demo
AUTO_TRADE=false

# Setup and portfolio risk. A score never increases these hard caps.
RISK_PER_TRADE=0.75
MAX_SETUP_RISK_PCT=1.0
MAX_TOTAL_OPEN_RISK_PCT=3.0
MAX_DAILY_LOSS_PCT=3.0
ABSOLUTE_DAILY_STOP_PCT=4.0
DAILY_PROFIT_LOCK_PCT=5.0
DAILY_PROFIT_STOP_PCT=10.0
MAX_CONSECUTIVE_LOSSES=3
MAX_TRADES_PER_DAY=10
MAX_OPEN_POSITIONS=2

# Market-derived target and quality requirements.
MIN_RR_RATIO=3.0
MIN_SETUP_SCORE=75.0
EXTREME_SETUP_SCORE=90.0
SCORE_THRESHOLD=75.0
SYMBOL_COOLDOWN_MINUTES=5
MAX_SIGNAL_AGE_MINUTES=10

# Entry modes: confirmed | aggressive | extreme.
# Aggressive still requires HTF context, liquidity sweep, displacement,
# BOS/CHOCH, retracement into a valid zone, structural SL and real target.
ENTRY_MODE=aggressive
ALLOW_AGGRESSIVE_ENTRY=true
ALLOW_EXTREME_ENTRY=false
LIQUIDITY_SWEEP_MIN_PENETRATION_ATR=0.05
DISPLACEMENT_BODY_RATIO_MIN=0.60
DISPLACEMENT_RANGE_RATIO_MIN=1.20
STRUCTURAL_STOP_ATR_BUFFER=0.15
MAX_CHASE_DISTANCE_ATR=0.50

# Basket layers always share one fixed setup-risk budget; never use them to
# average a losing trade.
MAX_LAYERS=4
LAYER_ALLOCATION=0.40,0.30,0.20,0.10

# Broker market discovery is authoritative. Leave symbols empty: the bot will
# populate active Synthetic Indices and broker-listed Gold from Deriv MT5 only.
SYMBOLS=
TIMEFRAMES=M15,H1,H4
HTF_TIMEFRAMES=H1,H4,D1
REQUIRE_DISPLACEMENT=true
REQUIRE_ZONE_RETEST=true
REQUIRE_CANDLE_CONFIRMATION=true
# Deriv Synthetic Indices are monitored continuously; there is no macro-news filter.
ENABLED_SESSIONS=all
DB_PATH=smc_bot.db

# Structural position management. Stops only move toward protection.
BREAKEVEN_AT_RR=1.0
PROFIT_LOCK_RR=1.5
RUNNER_RR=2.0
TRAILING_BUFFER_ATR=0.15
MIN_SL_UPDATE_DISTANCE_ATR=0.05
MIN_TP_UPDATE_DISTANCE_ATR=0.10
MIN_MINUTES_BETWEEN_MODIFICATIONS=5
ALLOW_PARTIAL_TP=true
ALLOW_TP_EXTENSION=true
PARTIAL_CLOSE_RR=2.0
PARTIAL_CLOSE_PERCENT=0.20
MAX_HOLD_BARS=100

# ─── WhatsApp Alerts (via CallMeBot) ────────────────────────
# Get your API key at https://www.callmebot.com/blog/free-api-whatsapp-messages/
WHATSAPP_PHONE=
WHATSAPP_APIKEY=

# ─── Advanced Risk ──────────────────────────────────────────
# Set a virtual balance for risk calculation (e.g. 500)
VIRTUAL_BALANCE=
