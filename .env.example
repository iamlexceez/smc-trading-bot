# ─── Telegram ──────────────────────────────────────────────
# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Comma-separated Telegram user IDs allowed to control the bot
# Find your ID by messaging @userinfobot on Telegram
TELEGRAM_ADMIN_IDS=123456789,987654321

# ─── MT5 Connection (leave blank for paper mode) ──────────
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

# ─── Trading Mode ─────────────────────────────────────────
# paper = no real trades, live = real MT5 execution
TRADING_MODE=paper

# ─── Risk Settings ────────────────────────────────────────
RISK_PER_TRADE=1.0
MAX_DAILY_LOSS_PCT=5.0
MAX_TRADES_PER_DAY=10
MAX_OPEN_POSITIONS=5
MIN_RR_RATIO=3.0
SCORE_THRESHOLD=40.0
MAX_SPREAD_PIPS=5.0
SYMBOL_COOLDOWN_MINUTES=30

# ─── Auto-Trade ───────────────────────────────────────────
AUTO_TRADE=false

# ─── Symbols & Timeframes ────────────────────────────────
SYMBOLS=EURUSD,GBPUSD,USDJPY,XAUUSD,Volatility 75 Index,Boom 500 Index,Crash 500 Index
TIMEFRAMES=M15,H1,H4
HTF_TIMEFRAMES=H1,H4,D1

# ─── Database ─────────────────────────────────────────────
DB_PATH=smc_bot.db

# ─── Market Data API (free) ────────────────────────────────
# Get a free key at https://twelvedata.com/pricing (optional)
# Without this, the bot uses yfinance (free, no key needed)
TWELVE_DATA_API_KEY=

# ─── Entry Confirmation ───────────────────────────────────
REQUIRE_ZONE_RETEST=true
REQUIRE_CANDLE_CONFIRMATION=true
REQUIRE_DISPLACEMENT=false

# ─── Trade Management ─────────────────────────────────────
BREAKEVEN_AT_RR=1.0
TRAIL_ATR_MULTIPLIER=2.0
PARTIAL_CLOSE_RR=2.0
PARTIAL_CLOSE_PERCENT=0.50
MAX_HOLD_BARS=100

# ─── Session Filtering ────────────────────────────────────
# Options: tokyo, london, new_york, overlap, all
ENABLED_SESSIONS=london,new_york,overlap

# ─── News Filter ──────────────────────────────────────────
NEWS_FILTER_ENABLED=true
NEWS_IMPACT_LEVELS=High
NEWS_BLACKOUT_MINUTES=15
